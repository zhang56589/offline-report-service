<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "mybatis-3-mapper.dtd">

<mapper namespace="com.report.mapper.ReportStatMapper">

    <insert id="insertStat">
        INSERT INTO report_stat(stat_date,total_order,total_amount)
        VALUES(#{statDate},#{totalOrder},#{totalAmount})
    </insert>

    <select id="selectByDate" resultType="com.report.entity.ReportStat">
        SELECT * FROM report_stat WHERE stat_date=#{statDate}
    </select>

    <!-- 新增：时间范围查询 -->
    <select id="selectByDateRange" resultType="com.report.entity.ReportStat">
        SELECT * FROM report_stat
        WHERE stat_date &gt;= #{startDate} AND stat_date &lt;= #{endDate}
    </select>

</mapper>
